{
  "name": "@hadden-industries/markdown-quality",
  "version": "1.0.3",
  "description": "Shared, bounded Markdown formatting, GFM linting, and local-link checking",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.23.3 || ^24.21.0 || >=26.10.0"
  },
  "bin": {
    "markdown-quality": "src/cli.js",
    "markdown-quality-qualify": "src/qualification-cli.js"
  },
  "exports": {
    ".": "./src/quality.js",
    "./configuration-schema": "./schemas/configuration.schema.json",
    "./result-schema": "./schemas/result.schema.json",
    "./migration-schema": "./schemas/migration.schema.json",
    "./execution-schema": "./schemas/execution.schema.json",
    "./qualification-observer": "./assets/qualification/observe.py"
  },
  "files": [
    "src",
    "schemas",
    "assets",
    "LICENSE",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "docs/consumer-guide.md",
    "docs/centralized-contracts.md",
    "docs/ci-trust.md",
    "docs/support-and-release.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hadden-Industries/markdown-quality.git"
  },
  "homepage": "https://github.com/Hadden-Industries/markdown-quality#readme",
  "bugs": {
    "url": "https://github.com/Hadden-Industries/markdown-quality/issues"
  },
  "keywords": [
    "markdown",
    "formatter",
    "linter",
    "gfm",
    "nodejs",
    "cli"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:focused": "node --test test/contracts.test.js",
    "check:affected": "node --test test/*.test.js",
    "check:full": "node scripts/verify.js",
    "format:code": "prettier --write src scripts test schemas assets docs package.json .markdown-quality.json .github/dependabot.yml .github/ISSUE_TEMPLATE",
    "format:markdown": "node src/cli.js format --root . --inventory git",
    "format": "npm run format:code && npm run format:markdown",
    "check:markdown": "node src/cli.js check --root . --inventory git"
  },
  "dependencies": {
    "@eslint/markdown": "8.0.3",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.9"
  },
  "optionalDependencies": {
    "@hadden-industries/markdown-quality-linux-x64": "file:packages/linux-x64",
    "@hadden-industries/markdown-quality-win32-x64": "file:packages/win32-x64"
  }
}
