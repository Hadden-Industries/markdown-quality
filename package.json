{
  "name": "@hadden-industries/markdown-quality",
  "version": "1.0.3",
  "description": "Shared, bounded Markdown formatting, GFM linting, and local-link checking",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "markdown-quality": "src/cli.js",
    "markdown-quality-qualify": "src/qualification-cli.js"
  },
  "exports": {
    ".": "./src/quality.js",
    "./configuration-schema": "./schemas/configuration.schema.json",
    "./result-schema": "./schemas/result.schema.json",
    "./migration-schema": "./schemas/migration.schema.json",
    "./execution-schema": "./schemas/execution.schema.json",
    "./qualification-observer": "./assets/qualification/observe.py"
  },
  "files": [
    "src",
    "schemas",
    "assets",
    "LICENSE",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "docs/consumer-guide.md",
    "docs/centralized-contracts.md",
    "docs/ci-trust.md",
    "docs/support-and-release.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hadden-Industries/markdown-quality.git"
  },
  "homepage": "https://github.com/Hadden-Industries/markdown-quality#readme",
  "bugs": {
    "url": "https://github.com/Hadden-Industries/markdown-quality/issues"
  },
  "keywords": [
    "markdown",
    "formatter",
    "linter",
    "gfm",
    "nodejs",
    "cli"
  ],
  "scripts": {
    "sync:node": "node scripts/project-node-support.js --write",
    "check:node": "node scripts/project-node-support.js --check",
    "test": "node --test test/*.test.js",
    "check:focused": "node --test test/contracts.test.js",
    "check:affected": "node scripts/affected-tests.js",
    "check:full": "node scripts/verify.js",
    "prettier": "prettier --ignore-unknown . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:code": "npm run prettier -- --write",
    "format:code:check": "npm run prettier -- --check",
    "format:markdown": "node src/cli.js format --root . --inventory git",
    "format": "npm run format:code && npm run format:markdown",
    "format:check": "npm run format:code:check && npm run check:markdown",
    "check:markdown": "node src/cli.js check --root . --inventory git",
    "graph:dependencies": "node scripts/dependency-graph.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:json": "node scripts/runRepositoryJsonQuality.mjs check",
    "inspect:json": "node scripts/runRepositoryJsonQuality.mjs check",
    "format:json": "node scripts/runRepositoryJsonQuality.mjs format",
    "format:json:check": "node scripts/runRepositoryJsonQuality.mjs check",
    "normalize:json": "node scripts/runRepositoryJsonQuality.mjs normalize",
    "lint:json:identity": "node scripts/lint-json-identity.mjs",
    "test:json": "node --test test/json-tooling/*.test.mjs",
    "check:product": "node scripts/verify.js --product",
    "qualify:json:packages": "node scripts/qualify-json-packages.mjs",
    "check:ci": "node scripts/check-workflows.js",
    "check:security": "node scripts/dependency-security.js",
    "ci:node-policy": "node scripts/ci-node-policy.js",
    "ci:producer-toolchain": "node scripts/qualification-process.js retain",
    "check:runtime": "node scripts/verify.js --runtime",
    "governance:inspect": "node scripts/github-governance.js"
  },
  "dependencies": {
    "@eslint/markdown": "8.0.3",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  },
  "bundleDependencies": [
    "@eslint/markdown",
    "eslint"
  ],
  "optionalDependencies": {
    "@hadden-industries/markdown-quality-linux-x64": "file:packages/linux-x64",
    "@hadden-industries/markdown-quality-win32-x64": "file:packages/win32-x64"
  },
  "devDependencies": {
    "@actions/artifact": "^6.3.1",
    "@hadden-industries/json-quality": ">=1.0.0-rc.2",
    "acorn": ">=8.19.0",
    "dependency-cruiser": ">=18.7.0",
    "micromark": ">=4.0.3",
    "micromark-extension-math": ">=3.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.1 <13",
      "onFail": "error"
    }
  }
}
