{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preset",
    "include"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "preset": {
      "const": "authored-gfm@1"
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "info",
          "warn",
          "error"
        ]
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontmatter": {
          "enum": [
            false,
            "yaml",
            "toml",
            "json"
          ]
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localFiles": {
          "type": "boolean"
        },
        "rootRelative": {
          "enum": [
            "reject",
            "root"
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endOfLine": {
          "enum": [
            "lf",
            "crlf",
            "preserve"
          ]
        },
        "tabWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    }
  },
  "$id": "urn:hadden-industries:markdown-quality:configuration:2"
}
