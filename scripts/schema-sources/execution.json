{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hadden-industries:markdown-quality:execution:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "resourceLimitMode": {
      "enum": [
        "configured",
        "unlimited"
      ]
    },
    "requiredConsecutiveSamples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockFile",
        "coreArchive",
        "nativeArchives"
      ],
      "properties": {
        "lockFile": {
          "type": "string",
          "minLength": 1
        },
        "coreArchive": {
          "type": "string",
          "minLength": 1
        },
        "nativeArchives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "win32-x64",
            "linux-x64"
          ],
          "properties": {
            "win32-x64": {
              "type": "string",
              "minLength": 1
            },
            "linux-x64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "python"
      ],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    }
  }
}
