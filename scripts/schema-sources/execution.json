{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hadden-industries:markdown-quality:execution:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "samples",
    "checkerMs",
    "windowMs",
    "memoryBytes",
    "nodeOldSpaceMb",
    "reportBytes",
    "requestBytes",
    "stagingBytes",
    "stagingEntries",
    "limits",
    "runtimes"
  ],
  "properties": {
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockFile",
        "coreArchive",
        "nativeArchives"
      ],
      "properties": {
        "lockFile": {
          "type": "string",
          "minLength": 1
        },
        "coreArchive": {
          "type": "string",
          "minLength": 1
        },
        "nativeArchives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "win32-x64",
            "linux-x64"
          ],
          "properties": {
            "win32-x64": {
              "type": "string",
              "minLength": 1
            },
            "linux-x64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "checkerMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "windowMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nodeOldSpaceMb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reportBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requestBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stagingBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stagingEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limits": {
      "type": "object",
      "additionalProperties": false
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "python"
      ],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    }
  }
}
