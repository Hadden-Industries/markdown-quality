{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "preset", "include"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "preset": { "const": "authored-gfm@1" },
    "include": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "exclude": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "ignoreFiles": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "lint": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": { "enum": ["off", "warn", "error"] }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localFiles": { "type": "boolean" },
        "rootRelative": { "enum": ["reject", "root"] }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endOfLine": { "enum": ["lf", "crlf", "preserve"] },
        "tabWidth": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    }
  }
}
