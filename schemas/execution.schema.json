{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hadden-industries:markdown-quality:execution:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "samples",
    "checkerMs",
    "windowMs",
    "memoryBytes",
    "nodeOldSpaceMb",
    "reportBytes",
    "requestBytes",
    "stagingBytes",
    "stagingEntries",
    "limits",
    "runtimes"
  ],
  "properties": {
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockFile", "coreArchive", "nativeArchives"],
      "properties": {
        "lockFile": { "type": "string", "minLength": 1 },
        "coreArchive": { "type": "string", "minLength": 1 },
        "nativeArchives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["win32-x64", "linux-x64"],
          "properties": {
            "win32-x64": { "type": "string", "minLength": 1 },
            "linux-x64": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "checkerMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "windowMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nodeOldSpaceMb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reportBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requestBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stagingBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stagingEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "configBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nativeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nativeOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "documentDiagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "diagnosticBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selectionBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "analysisMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workerHeapMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workerStackMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stagingMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stagingOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "patterns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "patternLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lintRules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "python"],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    }
  }
}
