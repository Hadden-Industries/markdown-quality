{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "preset": {
      "const": "authored-gfm@2"
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "info",
          "warn",
          "error"
        ]
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontmatter": {
          "enum": [
            false,
            "yaml",
            "toml",
            "json"
          ]
        }
      },
      "required": [
        "frontmatter"
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkLocalTargets": {
          "type": "boolean"
        },
        "rootRelative": {
          "enum": [
            "reject",
            "consumer-root"
          ]
        }
      },
      "required": [
        "checkLocalTargets",
        "rootRelative"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endOfLine": {
          "enum": [
            "lf",
            "crlf",
            "preserve"
          ]
        },
        "tabWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "endOfLine",
        "tabWidth"
      ]
    },
    "analyzerLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDocumentBytes",
        "maxTotalDocumentBytes",
        "maxPathsPerSelectionStage",
        "maxEnumeratedEntries",
        "maxConfigurationBytes",
        "nativeInvocationTimeoutMs",
        "maxNativeOutputBytes",
        "maxTotalDiagnostics",
        "maxDocumentDiagnostics",
        "maxDiagnosticJsonBytes",
        "maxInventoryBytes",
        "documentAnalysisTimeoutMs",
        "maxWorkerOldGenerationMiB",
        "workerStackMiB",
        "nativeStagingAccessTimeoutMs",
        "maxNativeStagingCommandOutputBytes",
        "maxPatternsPerList",
        "maxPatternCodePoints",
        "maxRuleOverrideCount",
        "maxReadDependencyDocuments"
      ],
      "properties": {
        "maxDocumentBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTotalDocumentBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxPathsPerSelectionStage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxEnumeratedEntries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxConfigurationBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nativeInvocationTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxNativeOutputBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTotalDiagnostics": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxDocumentDiagnostics": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxDiagnosticJsonBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxInventoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "documentAnalysisTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxWorkerOldGenerationMiB": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workerStackMiB": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nativeStagingAccessTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxNativeStagingCommandOutputBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxPatternsPerList": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxPatternCodePoints": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxRuleOverrideCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxReadDependencyDocuments": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$id": "urn:hadden-industries:markdown-quality:effective-configuration:3",
  "required": [
    "schemaVersion",
    "preset",
    "include",
    "exclude",
    "lint",
    "syntax",
    "links",
    "layout",
    "analyzerLimits"
  ]
}
