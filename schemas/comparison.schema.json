{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incumbent",
    "candidate",
    "added",
    "resolved",
    "retained",
    "messageChanges",
    "formattingDriftPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "incumbent": {
      "$ref": "#/definitions/identity"
    },
    "candidate": {
      "$ref": "#/definitions/identity"
    },
    "added": {
      "$ref": "#/definitions/diagnostics"
    },
    "resolved": {
      "$ref": "#/definitions/diagnostics"
    },
    "retained": {
      "$ref": "#/definitions/diagnostics"
    },
    "messageChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "$ref": "#/definitions/diagnostic"
          },
          "after": {
            "$ref": "#/definitions/diagnostic"
          }
        }
      }
    },
    "formattingDriftPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incumbent",
        "candidate"
      ],
      "properties": {
        "incumbent": {
          "$ref": "#/definitions/paths"
        },
        "candidate": {
          "$ref": "#/definitions/paths"
        }
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportSchemaVersion",
        "selectionSha256",
        "package",
        "tools",
        "configurationBytesSha256",
        "effectiveConfigurationSha256",
        "configuration",
        "policy",
        "strict",
        "exitCode",
        "inputManifestSha256"
      ],
      "properties": {
        "reportSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "selectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configurationBytesSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "effectiveConfigurationSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration": {
          "type": [
            "object",
            "null"
          ]
        },
        "policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "strict": {
          "type": "boolean"
        },
        "exitCode": {
          "enum": [
            0,
            1
          ]
        },
        "inputManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "rule",
        "line",
        "column",
        "message",
        "severity"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        }
      }
    }
  },
  "$id": "urn:hadden-industries:markdown-quality:comparison:3"
}
