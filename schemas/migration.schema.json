{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incumbent",
    "candidate",
    "added",
    "resolved",
    "retained",
    "messageChanges",
    "wouldFormat"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "incumbent": {
      "$ref": "#/definitions/identity"
    },
    "candidate": {
      "$ref": "#/definitions/identity"
    },
    "added": {
      "$ref": "#/definitions/diagnostics"
    },
    "resolved": {
      "$ref": "#/definitions/diagnostics"
    },
    "retained": {
      "$ref": "#/definitions/diagnostics"
    },
    "messageChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": {
            "$ref": "#/definitions/diagnostic"
          },
          "after": {
            "$ref": "#/definitions/diagnostic"
          }
        }
      }
    },
    "wouldFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incumbent", "candidate"],
      "properties": {
        "incumbent": {
          "$ref": "#/definitions/paths"
        },
        "candidate": {
          "$ref": "#/definitions/paths"
        }
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportSchemaVersion",
        "package",
        "tools",
        "configDigest",
        "configuration",
        "policy",
        "strict",
        "exitCode",
        "inputDigest"
      ],
      "properties": {
        "reportSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configDigest": {
          "type": ["string", "null"]
        },
        "configuration": {
          "type": ["object", "null"]
        },
        "policy": {
          "type": ["object", "null"]
        },
        "strict": {
          "type": "boolean"
        },
        "exitCode": {
          "enum": [0, 1]
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "rule",
        "line",
        "column",
        "message",
        "severity"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        }
      }
    }
  }
}
