name: Manual qualification model fixture
on:
  workflow_dispatch:
    inputs:
      trusted-sha:
        type: string
        required: true
permissions:
  contents: read
jobs:
  shared:
    uses: ./.github/workflows/markdown-quality.yml
    with:
      trusted-sha: ${{ inputs.trusted-sha }}
      candidate-sha: ${{ inputs.trusted-sha }}
      trusted-repository: example/trusted
      candidate-repository: example/candidate
      profile: .markdown-quality-execution.json
